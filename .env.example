# 로컬 개발 환경(로컬 Supabase + 선택적으로 로컬 LLM) 구축 절차는 docs/local-setup.md 참고.
# 주의: 코드가 load_dotenv(override=True) 로 읽으므로 이 파일이 셸 환경변수를 덮어쓴다.
#       `EMBEDDING_MODEL=... python main.py` 처럼 앞에 붙여도 소용없고, 여기를 고쳐야 한다.

UPSTAGE_API_KEY=your_upstage_api_key
LLM_BASE_URL=https://api.upstage.ai/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=solar-embedding-1-large-passage
EMBEDDING_PASSAGE_MODEL=solar-embedding-1-large-passage
EMBEDDING_QUERY_MODEL=solar-embedding-1-large-query
EMBEDDING_DIMENSIONS=4096
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=0

# 로컬 Supabase 를 쓸 때는 아래 값으로 바꾼다 (hannoon-supabase 에서 supabase start 후).
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=your_postgres_database_url

# --- 로컬 Ollama 로 돌릴 때 (비용 0). docs/local-setup.md 경로 B ---
# 임베딩은 반드시 프록시를 거쳐야 한다: python scripts/local_embedding_proxy.py
# 스키마가 vector(4096) 인데 bge-m3 는 1024차원이라, 프록시가 0을 채워 맞춘다
# (제로 패딩은 코사인 거리를 바꾸지 않는다).
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=local
#   EMBEDDING_BASE_URL=http://127.0.0.1:11500/v1
#   EMBEDDING_API_KEY=local
#   EMBEDDING_MODEL=bge-m3
#   EMBEDDING_PASSAGE_MODEL=bge-m3
#   EMBEDDING_QUERY_MODEL=bge-m3
#   (LLM_*_MODEL 은 모두 qwen3:30b-instruct 등 로컬 모델명으로)

LLM_DEFAULT_MODEL=solar-mini
LLM_CLEANUP_MODEL=solar-mini
LLM_ARTICLE_MODEL=solar-mini
LLM_SUMMARY_MODEL=solar-mini
LLM_TOPIC_EVENT_MODEL=solar-pro3
LLM_EVENT_MODEL=solar-pro3
LLM_TOPIC_MODEL=solar-pro3

EVENT_BATCH_SIZE=5
EVENT_CANDIDATE_LIMIT=12
EVENT_DISTANCE_THRESHOLD=0.40
# 후보검색 시간 윈도우(일). updated_at 기준이며, 확장 시 휴면 이벤트도 회수 대상에 포함된다.
EVENT_CANDIDATE_WINDOW_DAYS=2
EVENT_ASSIGN_SCORE_THRESHOLD=0.80
# 이벤트 벡터 갱신 방식: anchor(기본, 첫 기사에 고정) | centroid(배정마다 구성원 평균)
# anchor 는 이벤트가 커질수록 대표성을 잃는다. 바꾸면 후보 검색 결과가 통째로 달라지므로
# eval/event_harness.py 로 재본 뒤 켜세요.
EVENT_EMBEDDING_UPDATE=anchor
TOPIC_BATCH_SIZE=10
TOPIC_CANDIDATE_LIMIT=12
TOPIC_MIN_NET_ARTICLE_COUNT=5
TOPIC_DISTANCE_THRESHOLD=0.90
TOPIC_ASSIGN_SCORE_THRESHOLD=0.75
# 계층(부모→서브토픽) 분류. false면 기존 평면 모드 (기본값).
TOPIC_SUBTOPICS_ENABLED=false
TOPIC_SUBTOPIC_CANDIDATE_LIMIT=12
# 서브토픽 배정 방식: embedding(이벤트 임베딩 최근접, LLM 미사용) | llm(프롬프트 판단)
TOPIC_SUBTOPIC_MODE=embedding
# embedding 모드에서 기존 서브토픽 편입에 필요한 최소 코사인 유사도
TOPIC_SUBTOPIC_SIM_THRESHOLD=0.55
# llm 모드 전용: 서브토픽 assign 점수 문턱 (미지정 시 TOPIC_ASSIGN_SCORE_THRESHOLD)
TOPIC_SUBTOPIC_ASSIGN_SCORE_THRESHOLD=0.75
# create 직전 중복 방지 가드: 동일 스코프(최상위 또는 같은 부모 아래) 내 기존 토픽과
# difflib 제목 유사도가 이 값 이상이면 create를 assign으로 강등한다.
TOPIC_DUP_SIM_THRESHOLD=0.85
# 부모 토픽 배정 프롬프트: broad(광의 테마, 기본) | strict(사건 연속성)
PARENT_PROMPT_MODE=broad
